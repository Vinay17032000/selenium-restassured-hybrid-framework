<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Automation Suite" parallel="classes" thread-count="4">
    <listeners>
        <listener class-name="com.framework.listeners.TestListener"/>
    </listeners>
    <test name="UI Tests">
        <packages>
            <package name="com.framework.ui"/>
        </packages>
    </test>
    <test name="API Tests">
        <packages>
            <package name="com.framework.api"/>
        </packages>
    </test>
</suite>
